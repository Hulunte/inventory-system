# === Production Configuration ===
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# Database (PostgreSQL required)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/inventory_db
TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/inventory_test_db

# Security
SECRET_KEY=replace-with-a-real-secret-key-at-least-16-chars
ADMIN_PASSWORD_HASH=replace-with-generated-password-hash

# Timezone
HARVEST_TIMEZONE=America/Chihuahua

# Session security (set to true if using HTTPS)
SESSION_COOKIE_SECURE=false

# Backup configuration
BACKUP_DIR=C:\backups\inventory-system
PG_DUMP_PATH=pg_dump

# Server configuration
APP_HOST=0.0.0.0
APP_PORT=5000
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=your-email@gmail.com
MAIL_SMTP_APP_PASSWORD=your-app-password
MAIL_FROM_NAME=Sistema de Cosecha
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_USE_TLS=true
MAIL_TIMEOUT_SECONDS=30
TICKET_BUSINESS_NAME=Sistema de Cosecha
TICKET_FOOTER_TEXT=Conserve este comprobante
TICKET_PAPER_WIDTH_MM=80
TICKET_CHARACTERS_PER_LINE=48
TICKET_PRINTER_NAME=
TICKET_ENCODING=cp850
TICKET_AUTO_CUT=true
SCALE_PORT=COM7
SCALE_BAUDRATE=9600
SCALE_BYTESIZE=8
SCALE_PARITY=E
SCALE_STOPBITS=2
SCALE_TERMINATOR=CRCRLF
SCALE_TIMEOUT_SECONDS=1.0
SCALE_LINE_ENCODING=ascii
SCALE_PROFILE=auto
SCALE_MIN_WEIGHT_KG=0.001
SCALE_MAX_WEIGHT_KG=999.999
